# MongoDB Configuration
# Get your MongoDB connection string from https://www.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority

# JWT Secret Key
# Generate a strong random string for production (e.g., openssl rand -base64 32)
# This is used to sign and verify authentication tokens
JWT_SECRET=your_secret_key_here_make_it_long_and_random

# AI Engine URL
# This is the public URL from your Google Colab Ngrok tunnel
# Example: https://xxxx-xxxx-xxxx.ngrok-free.app/
# Note: This URL changes every time you restart the Colab notebook
AI_ENGINE_URL=https://your-ngrok-url.ngrok-free.app/

# Server Port
# The port on which the backend server will run
PORT=5000

# Frontend URL (for production CORS)
# Set this to your production frontend URL when deploying
# For development, localhost:5173 is used automatically
# FRONTEND_URL=https://your-frontend-domain.com

# Node Environment
# Set to 'production' when deploying to production
# NODE_ENV=development
